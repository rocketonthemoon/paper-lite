{
  "name": "weft",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "weft — self-hosted HTML/CSS design canvas with a live MCP server",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "prestart": "node scripts/ensure-ui-build.mjs",
    "build": "vite build --config ui/vite.config.js",
    "dev:ui": "vite --config ui/vite.config.js",
    "lint": "node test/lint.mjs",
    "pretest": "npm run build",
    "test": "node --test --test-force-exit test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "isomorphic-git": "^1.44.12",
    "parse5": "^8.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "interactjs": "^1.10.29",
    "svelte": "^5.57.3",
    "vite": "^8.3.8"
  }
}
